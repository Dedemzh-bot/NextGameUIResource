# Copy to .env locally. Never commit your .env or generated manifests.
# Use absolute paths for directories outside this checkout. Forward slashes work on Windows.
NEXTGAME_UI_SOURCE_DIR=C:/YourWorkspace/UI/Incoming
NEXTGAME_UI_OUTPUT_DIR=C:/YourWorkspace/UI/Organized
NEXTGAME_PROJECT_ROOT=C:/YourWorkspace/YourGame
# If omitted, the table defaults to PROJECT_ROOT/Content/Settings/resource/resource.txt.
# NEXTGAME_UI_RESOURCE_TABLE=C:/YourWorkspace/YourGame/Content/Settings/resource/resource.txt
NEXTGAME_UI_WORK_DIR=.local/work
NEXTGAME_TEXTUREPACKER_EXE=C:/YourTools/TexturePacker/bin/TexturePacker.exe
NEXTGAME_UI_TPS_TEMPLATE=templates/default.tps
NEXTGAME_UI_SYSTEM_MAP=.local/system-map.json
NEXTGAME_UI_ID_CATALOG=.local/id-catalog.json
NEXTGAME_UI_ID_ASSIGNMENTS=.local/id-assignments.json
# Optional: use the project's existing NxUE CLI instead of the bundled HTTP adapter.
# NEXTGAME_NXUE_CLI=C:/YourWorkspace/YourGame/Tools/nxue/nxue.py
